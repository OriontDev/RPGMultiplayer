{
	"name": "Login events",
	"events": [
		{
			"eventType": "comment",
			"text": "These global variables store the username and room name that we enter on the login screen. It's then read from the 'Chat' layout and used when logging in to the signalling server."
		},
		{
			"eventType": "variable",
			"name": "MyUsername",
			"type": "string",
			"initialValue": "",
			"comment": "Name entered on login screen",
